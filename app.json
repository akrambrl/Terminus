{
  "expo": {
    "name": "Terminus Paris",
    "slug": "terminus-paris",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.terminusparis.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15123D",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.terminusparis.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "terminusparis",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#15123D"
        }
      ],
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-4450845101011880~9098886467",
          "androidAppId": "ca-app-pub-4450845101011880~8427309339",
          "userTrackingUsageDescription": "Cela permet d'afficher des publicités plus adaptées à vos centres d'intérêt et de garder Terminus gratuit.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Cela permet d'afficher des publicités plus adaptées à vos centres d'intérêt et de garder Terminus gratuit."
        }
      ]
    ]
  }
}
